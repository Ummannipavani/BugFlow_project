# Google Gemini API key (server-side only — never expose in frontend)
GEMINI_API_KEY=

# PostgreSQL connection string (Neon, local Postgres, etc.)
DATABASE_URL=

# JWT signing secret for authentication tokens
JWT_SECRET=

# Minimum cosine relevance score for semantic defect search. Calibrate this
# against a representative labeled query set for the deployed embedding model.
SEMANTIC_SEARCH_MIN_SCORE=0.70

# Optional: hosting base URL for self-referential links
APP_URL=
